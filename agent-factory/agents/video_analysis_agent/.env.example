# ===== Gemini Configuration =====
# Google Gemini API key for video analysis
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to use
GEMINI_MODEL=gemini-1.5-pro-latest

# Maximum output tokens for Gemini
GEMINI_MAX_OUTPUT_TOKENS=8192

# Temperature for Gemini generation (0-1)
GEMINI_TEMPERATURE=0.4

# ===== Whisper Configuration =====
# OpenAI API key (only needed if using Whisper API)
WHISPER_API_KEY=your-openai-api-key-here

# Whisper model size (tiny, base, small, medium, large, large-v3)
WHISPER_MODEL=large-v3

# Use OpenAI API (true) or local model (false)
WHISPER_USE_API=false

# Language code for transcription
WHISPER_LANGUAGE=en

# ===== Video Processing Configuration =====
# Frames per second to extract for analysis
VIDEO_FPS_EXTRACTION=1

# Maximum video duration in minutes
VIDEO_MAX_DURATION_MINUTES=120

# ===== Semantic Chunking Configuration =====
# Similarity threshold for semantic boundaries (0-1)
CHUNK_SIMILARITY_THRESHOLD=0.75

# Minimum chunk duration in seconds
CHUNK_MIN_DURATION_SECONDS=5

# Maximum chunk duration in seconds
CHUNK_MAX_DURATION_SECONDS=300

# Use CLIP embeddings for semantic chunking
USE_CLIP_CHUNKING=true

# CLIP model for visual embeddings
CLIP_MODEL=ViT-B/32

# ===== Knowledge Graph Configuration =====
# Minimum occurrences to include pattern in KG
KG_MIN_PATTERN_OCCURRENCES=2

# Minimum confidence for rule inclusion (0-1)
KG_CONFIDENCE_THRESHOLD=0.6

# ===== Output Configuration =====
# Directory for generated outputs
OUTPUT_DIRECTORY=output

# Output format (json, yaml, txt)
OUTPUT_FORMAT=json

# ===== LLM Configuration (for agent orchestration) =====
# API key for LLM orchestration
LLM_API_KEY=your-llm-api-key-here

# LLM model for agent orchestration
LLM_MODEL=gpt-4o-mini

# Base URL for LLM API
LLM_BASE_URL=https://api.openai.com/v1

# ===== Processing Configuration =====
# Enable retry logic for API failures
ENABLE_RETRY=true

# Maximum number of retries
MAX_RETRIES=3

# Delay between retries in seconds
RETRY_DELAY_SECONDS=5
